{
  "schema_id": "claim_line_items_schema_v1.0",
  "dataset": "claim_line_items.csv",
  "description": "Schema contract for the claim line items table — the decision-grain dataset for billed services.",
  "version": "1.0",
  "effective_date": "2026-08-01",
  "grain": "One row = one billed service line within a claim",
  "primary_key": "claim_line_id",
  "unique_constraints": [
    ["claim_id", "line_number"]
  ],
  "fields": [
    {
      "name": "claim_line_id",
      "data_type": "string",
      "pattern": "^LI-[0-9]{5}$",
      "nullable": false,
      "unique": true,
      "key_status": "PK",
      "description": "Unique identifier for the service line"
    },
    {
      "name": "claim_id",
      "data_type": "string",
      "pattern": "^CLM-[0-9]{5}$",
      "nullable": false,
      "key_status": "FK",
      "references": {
        "table": "claims_ledger",
        "field": "claim_id"
      },
      "description": "Reference to the parent claim"
    },
    {
      "name": "line_number",
      "data_type": "integer",
      "nullable": false,
      "constraints": {
        "minimum": 1
      },
      "description": "Order of the service line within the claim; unique per claim_id"
    },
    {
      "name": "procedure_code",
      "data_type": "string",
      "pattern": "^CPT-[0-9]{5}$",
      "nullable": false,
      "key_status": "FK",
      "references": {
        "table": "procedure_catalog",
        "field": "procedure_code"
      },
      "description": "CPT procedure code for the service"
    },
    {
      "name": "service_date",
      "data_type": "date",
      "format": "ISO 8601 (YYYY-MM-DD)",
      "nullable": false,
      "constraints": {
        "must_fall_within": "parent claim's service window"
      },
      "description": "Date the service was performed; used as the point-in-time anchor"
    },
    {
      "name": "units",
      "data_type": "integer",
      "nullable": false,
      "constraints": {
        "minimum": 1
      },
      "observed_values": [1, 2],
      "description": "Number of units or procedures performed"
    },
    {
      "name": "billed_amount",
      "data_type": "decimal(10,2)",
      "nullable": false,
      "constraints": {
        "minimum": 0.01
      },
      "description": "Total USD amount billed for the line (already reflects units); NOT a per-unit rate"
    },
    {
      "name": "allowed_amount",
      "data_type": "decimal(10,2)",
      "nullable": false,
      "zero_is_valid": true,
      "constraints": {
        "minimum": 0,
        "must_be_less_than_or_equal_to": "billed_amount when > 0"
      },
      "description": "Allowed amount by payer; 0.00 means not-yet-adjudicated"
    },
    {
      "name": "paid_amount",
      "data_type": "decimal(10,2)",
      "nullable": false,
      "zero_is_valid": true,
      "constraints": {
        "minimum": 0,
        "must_be_less_than_or_equal_to": "allowed_amount when > 0"
      },
      "description": "Paid amount by payer; 0.00 means not-yet-paid"
    },
    {
      "name": "modifier_code",
      "data_type": "string",
      "nullable": true,
      "allowed_values": ["RT", "LT", "50", "26", ""],
      "description": "Valid CPT modifier or blank"
    },
    {
      "name": "denial_reason_code",
      "data_type": "string",
      "nullable": true,
      "pattern": "^[A-Z]{2}-[0-9]{2}$",
      "observed_values": ["CO-10", "CO-11", "CO-12", "CO-13", "CO-50", "OA-23", "PR-16", "PR-6"],
      "description": "Populated only when the line is denied or adjusted"
    }
  ],
  "source_of_truth": "Core Claims System (derived extract)",
  "freshness_sla": "<=24h stale after claim updates",
  "related_contract": "claim_line_items_semantic_contract_v1.json"
}